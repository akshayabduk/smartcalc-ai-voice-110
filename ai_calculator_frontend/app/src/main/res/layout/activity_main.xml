<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA">

    <!-- Top navigation bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/toggleTheme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_dark_mode"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Theme"
            app:tint="#F9AB00" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/historyBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="History"
            app:tint="#1A73E8" />

    </LinearLayout>

    <!-- Input panel -->
    <LinearLayout
        android:id="@+id/inputPanel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E9ECEF"
        android:padding="6dp"
        android:radius="14dp">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Enter calculation or ask in plain English…"
            android:textSize="18sp"
            android:padding="10dp"
            android:background="@android:color/transparent"
            android:textColor="#1A202C"
            android:inputType="text"
            android:maxLines="2"/>

        <ImageButton
            android:id="@+id/micBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Voice Input"
            app:tint="#34A853"
            android:layout_marginEnd="6dp"/>

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="Send Query"
            app:tint="#1A73E8" />
    </LinearLayout>

    <!-- Results panel -->
    <LinearLayout
        android:id="@+id/resultsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical"
        android:background="#FFF"
        android:padding="18dp"
        android:elevation="2dp"
        android:radius="16dp">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Result"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/aiExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI explanation for your answer will appear here."
            android:textSize="16sp"
            android:textColor="#F9AB00"
            android:gravity="center" />
    </LinearLayout>

    <!-- History panel (hidden by default) -->
    <LinearLayout
        android:id="@+id/historyPanel"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#F3F3F3"
        android:layout_marginTop="12dp"
        android:radius="16dp"
        android:elevation="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculation History"
            android:textStyle="bold"
            android:textColor="#222"
            android:paddingTop="10dp"
            android:paddingStart="10dp"
            android:textSize="18sp"/>
        <ListView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#34A853"
            android:dividerHeight="1dp"/>
    </LinearLayout>
</LinearLayout>
